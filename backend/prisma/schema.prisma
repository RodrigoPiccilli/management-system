generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

/// Represents NVR Job. 
model NVRJob {
    /// Primary Key (UUID Generated by Database)
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    /// Unique NVR job name. No NVR job will have a duplicate name.
    jobName String @unique

    /// Area code associated with job location.
    areaCode String?

    /// Floor plan model. 
    model String?

    /// Floor plan direction.
    direction String?

    /// Stone type used.
    stone String?

    /// Whether job includes backsplash.
    backsplash Boolean?

    /// Scheduled installation date.
    installDate DateTime? @db.Date

    /// Total square footage.
    ft2 Float?

    /// Community name.
    community String?

    /// Street address.
    address String?

    /// Sink type used.
    sink String?

    /// Monetary amount received.
    amount Float?

    /// Purchase order number.
    poNumber String?

    /// Installer responsible for installation.
    installedBy String?
}

/// Represents Homeowner Job.
model HomeownerJob {
    /// Primary Key (UUID Generated by Database)
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    /// Unique Homeowner job name. No Homeowner job will have a duplicate name.
    jobName String @unique

    /// Stone type used.
    stone String?

    /// Scheduled installation date.
    installDate DateTime? @db.Date

    /// Total square footage.
    ft2 Float?

    /// Street address.
    address String?

    /// Sink type used.
    sink String?

    /// Monetary amount received.    
    amount Float?

    /// Whether deposit payment has been received yet.
    deposit Boolean?

    /// Whether final payment has been received yet.
    final Boolean?

    /// Installer responsible for installation.
    installedBy String?
}

/// Represents Contractor Job.
model ContractorJob {
    /// Primary Key (UUID Generated by Database)
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    /// Unique Contractor job name. No Contractor job will have a duplicate name.
    jobName String @unique

    /// Name of Contractor Company
    contractor String

    /// Stone type used.
    stone String?

    /// Scheduled installation date.
    installDate DateTime? @db.Date

    /// Installer responsible for installation.
    installedBy String?

    /// Total square footage.
    ft2 Float?

    /// Street address.
    address String?

    /// Sink type used.
    sink String?

    /// Monetary amount received.    
    amount Float?

    /// Whether deposit payment has been received yet.
    deposit Boolean?

    /// Whether final payment has been received yet.
    final Boolean?
}

/// Represents Repair Job.
model Repair {
    /// Primary Key (UUID Generated by Database)
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    /// Unique Repair job name. In the case of multiple repairs for the same job, the entry will be updated.
    jobName String @unique

    /// Scheduled installation date.
    installDate DateTime? @db.Date

    /// Installer responsible for installation.
    installedBy String?

    /// Whether the repair requires a change order (additional charges to the builder). 
    changeOrder Boolean?

    /// Notes regarding repair job.
    notes String?
}

/// Represents a Mapping Between a Job Prefix and the Associated Area Code and Community.
model PrefixMapping {
    /// Primary Key (UUID Generated by Database)
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    /// Unique two letter identifier for a community. Each community will have an unique prefix.
    prefix String @unique

    /// Area code associated with job location.
    areaCode String

    /// Community name.
    community String
}
